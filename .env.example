# .env.example - Bank App örnek ortam değişkenleri
# KULLANIM: Bu dosyayı kopyalayarak `.env` oluşturun ve gerçek secret'ları
# yalnızca güvenli ortamlarda saklayın (CI/CD secret store, OS secret manager vb.).

# --- Uygulama ---
APP_PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (GÜVENLİK) ---
# Production için güçlü, rastgele bir base64 string kullanın.
# Örnek üretim komutu (lokalde): openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_BASE64_SECRET
JWT_TTL=60 # dakika cinsinden

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=6432
PG_USER=postgres
PG_PASS=your_database_password_here
PG_DB=bankapp
PG_IDLE_TIME=300
PG_MAX_CONNS=10

# --- Redis (opsiyonel) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Kart şifreleme anahtarı (GÜVENLİK) ---
# AES-GCM kullanılıyor; güçlü bir base64-encoded anahtar kullanın (en az 32 bayt önerilir)
CARD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_KEY

# Notlar:
# - Bu dosya örnektir. Gerçek secret'ları asla versiyon kontrolüne göndermeyin.
# - `.env` dosyanızı `.gitignore` içine ekleyin.
# - JWT_SECRET veya CARD_ENCRYPTION_KEY değiştirildiğinde mevcut JWT'ler ve
#   önceki şifrelemeler geçersizleşebilir — anahtar rotasyonu politikası hazırlayın.
